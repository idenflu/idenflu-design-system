{
  "id": "select",
  "label": "Select",
  "status": "implemented",
  "props": [
    {
      "name": "options",
      "kind": "unknown",
      "required": true
    },
    {
      "name": "label",
      "kind": "string",
      "required": true
    },
    {
      "name": "hideLabel",
      "kind": "boolean",
      "required": false
    },
    {
      "name": "name",
      "kind": "string",
      "required": false
    },
    {
      "name": "disabled",
      "kind": "boolean",
      "required": false
    },
    {
      "name": "placeholder",
      "kind": "string",
      "required": false
    },
    {
      "name": "className",
      "kind": "string",
      "required": false
    },
    {
      "name": "size",
      "kind": "enum",
      "required": false,
      "values": [
        "sm",
        "md",
        "lg"
      ]
    },
    {
      "name": "required",
      "kind": "boolean",
      "required": false
    },
    {
      "name": "helperText",
      "kind": "node",
      "required": false
    },
    {
      "name": "error",
      "kind": "node",
      "required": false
    },
    {
      "name": "prefixIcon",
      "kind": "node",
      "required": false
    },
    {
      "name": "popupStrategy",
      "kind": "enum",
      "required": false,
      "values": [
        "absolute",
        "fixed"
      ]
    },
    {
      "name": "value",
      "kind": "string",
      "required": false
    },
    {
      "name": "defaultValue",
      "kind": "string",
      "required": false
    }
  ],
  "states": [
    "default",
    "disabled",
    "error",
    "open",
    "readOnly"
  ],
  "accessibility": [
    {
      "id": "label",
      "rule": "Each control exposes an accessible label and listbox relationships."
    },
    {
      "id": "keyboard",
      "rule": "Arrow keys navigate options; Enter selects and Escape closes the list."
    }
  ],
  "notes": [
    "Select and SearchSelect use string values; MultiSelect uses string arrays.",
    "SearchSelect supports filtering; MultiSelect supports searchable and inline presentations."
  ]
}
