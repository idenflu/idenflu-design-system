{
  "id": "select",
  "label": "Select",
  "status": "implemented",
  "props": [
    {
      "name": "children",
      "kind": "node",
      "required": false
    },
    {
      "name": "chipSize",
      "kind": "enum",
      "values": ["sm", "md"],
      "required": false,
      "default": "sm",
      "description": "Chip size when valueDisplay is chip."
    },
    {
      "name": "className",
      "kind": "string",
      "required": false
    },
    {
      "name": "defaultOpen",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "defaultValue",
      "kind": "unknown",
      "required": false,
      "description": "string | string[] depending on multiple."
    },
    {
      "name": "disabled",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "error",
      "kind": "string",
      "required": false
    },
    {
      "name": "fullWidth",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "helperText",
      "kind": "string",
      "required": false
    },
    {
      "name": "id",
      "kind": "string",
      "required": false
    },
    {
      "name": "label",
      "kind": "node",
      "required": false
    },
    {
      "name": "multiple",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "name",
      "kind": "string",
      "required": false
    },
    {
      "name": "open",
      "kind": "boolean",
      "required": false
    },
    {
      "name": "options",
      "kind": "unknown",
      "required": false,
      "description": "SelectOption[] alternative to SelectItem children."
    },
    {
      "name": "overflow",
      "kind": "enum",
      "values": ["wrap", "ellipsis"],
      "required": false,
      "default": "wrap"
    },
    {
      "name": "placeholder",
      "kind": "string",
      "required": false,
      "default": "Select"
    },
    {
      "name": "readOnly",
      "kind": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "required",
      "kind": "boolean",
      "required": false
    },
    {
      "name": "searchPlaceholder",
      "kind": "string",
      "required": false,
      "default": "Search…"
    },
    {
      "name": "searchable",
      "kind": "boolean",
      "required": false,
      "default": true,
      "description": "Show filter input at the top of the option panel."
    },
    {
      "name": "size",
      "kind": "enum",
      "values": ["lg", "md", "sm"],
      "required": false,
      "default": "md"
    },
    {
      "name": "value",
      "kind": "unknown",
      "required": false,
      "description": "string | string[] depending on multiple."
    },
    {
      "name": "valueDisplay",
      "kind": "enum",
      "values": ["chip", "text"],
      "required": false,
      "default": "chip"
    },
    {
      "name": "variant",
      "kind": "enum",
      "values": ["default", "filled", "outlined"],
      "required": false,
      "default": "default"
    }
  ],
  "states": ["default", "disabled", "error", "open"],
  "accessibility": [
    {
      "id": "visible-label",
      "rule": "Provide a visible label or accessible name for the select field."
    },
    {
      "id": "listbox-select",
      "rule": "Button trigger with aria-expanded/haspopup; options in a listbox with keyboard highlight and selection."
    },
    {
      "id": "panel-search",
      "rule": "When searchable, panel search input filters options; Arrow keys move highlight, Enter selects."
    },
    {
      "id": "chips",
      "rule": "When valueDisplay is chip, selected values are removable chips with accessible delete labels."
    }
  ],
  "notes": [
    "Events (onOpenChange, onValueChange) are framework-specific and omitted.",
    "Custom portal listbox (no Radix). Replaces former Radix Select and covers Combobox use cases.",
    "Synced from packages/ui-react SelectProps (engineering-first)."
  ]
}
