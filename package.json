{
  "name": "idenflu-design-system",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:foundations": "npm run build:foundations -w @idenflu/ui-foundations",
    "build:tokens": "npm run build:tokens -w @idenflu/ui-tokens",
    "check:docs": "node docs/scripts/verify-site.js",
    "check:packages": "node scripts/package-skeleton-check.js",
    "check:api-contracts": "npm run check:api-contracts -w @idenflu/ui-react",
    "check": "node docs/scripts/verify-site.js && node scripts/package-skeleton-check.js && npm run check:icons",
    "storybook:ui-react": "npm -w @idenflu/ui-react run storybook",
    "generate:icons": "npm run generate:icons -w @idenflu/ui-react",
    "check:icons": "npm run check:icons -w @idenflu/ui-react",
    "docs:react": "vite --config docs/react-studio/vite.config.ts",
    "build:react-docs": "vite build --config docs/react-studio/vite.config.ts",
    "check:react-docs": "tsc -p docs/react-studio/tsconfig.json --noEmit",
    "test:react-docs": "node docs/react-studio/scripts/verify.cjs"
  }
}
