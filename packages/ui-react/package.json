{
  "name": "@idenflu/ui-react",
  "version": "0.0.0-alpha.17",
  "description": "React components for idenflu product interfaces.",
  "types": "./src/index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/idenflu/idenflu-design-system.git",
    "directory": "packages/ui-react"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "src",
    "README.md",
    "dist"
  ],
  "sideEffects": [
    "./src/styles.css",
    "./src/fonts.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@idenflu/ui-icons": "*",
    "@idenflu/ui-tokens": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "modern-normalize": "^3.0.1",
    "pretendard": "^1.3.9",
    "radix-ui": "^1.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.4.4",
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/addon-mcp": "^0.6.0",
    "@storybook/addon-themes": "^10.4.4",
    "@storybook/addon-vitest": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@types/node": "^25.9.3",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.25.12",
    "playwright": "^1.60.0",
    "storybook": "^10.4.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css",
    "./fonts.css": "./src/fonts.css",
    "./icons": {
      "types": "./src/icons/index.ts",
      "default": "./dist/icons/index.mjs"
    }
  },
  "typesVersions": {
    "*": {
      "icons": [
        "./src/icons/index.ts"
      ]
    }
  },
  "scripts": {
    "check:api-contracts": "node ./scripts/validate-api-contracts.js",
    "storybook:ui-react": "npm run storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check:icons": "node scripts/generate-icons.mjs --check",
    "build:icons": "npm run check:icons && node scripts/build-icons.mjs",
    "test:icons": "npm run build:icons && node --test scripts/icons.test.mjs",
    "prestorybook": "npm run build:icons",
    "prebuild-storybook": "npm run build:icons",
    "prepack": "npm run build:icons"
  }
}
